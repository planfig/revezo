# Copy to .env and fill in. Never commit .env.

# Key clients must send as "Authorization: Bearer <key>". Generate a long random value.
REVEZO_API_KEY=

# Encrypts the API keys you add on the dashboard (AES-256-GCM). At least 24 characters.
# Keep it safe: without the same key, providers added on the dashboard cannot be loaded.
# Leave empty to keep the dashboard read only.
REVEZO_SECRETS_KEY=

# Optional: path to the config file (default: ./revezo.config.yaml)
REVEZO_CONFIG=

# Provider credentials referenced from revezo.config.yaml as ${NAME}
BREVO_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
